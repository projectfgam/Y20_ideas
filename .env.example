# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Shared Cloud Database Configuration for Web Hosting:
# Set VITE_FIRESTORE_PROJECT_ID to share ideas, ratings, and approvals across all devices via Firebase Firestore REST.
# VITE_FIRESTORE_PROJECT_ID=""
# Or set a Firebase Realtime Database / custom REST JSON endpoint:
# VITE_CLOUD_PROVIDER="firebase-rtdb"
# VITE_CLOUD_ENDPOINT=""
